# Copy to .env and adjust for your environment:
#   cp .env.example .env
#   cp .env.invite.example .env.invite
#   cp .test.env.example .test.env   # optional private Invite/SURFconext profile
#
# Toggle Invite + demo-app OIDC profile (compose env_file on invite_bridge/application):
#   ENV_FILE=.env.invite   # shared / current OpenConext Invite
#   ENV_FILE=.test.env     # your private Invite (safe retries)
# Then: docker compose -f compose.yml -f compose.traefik.yml up -d --force-recreate --no-deps invite_bridge application

ENV_FILE=.env.invite

# --- Traefik / hostnames ----------------------------------------------------
DOMAIN=example.org
TRAEFIK_NETWORK=external
TRAEFIK_CERT_RESOLVER=le

# --- MidPoint ---------------------------------------------------------------
# Image tag suffix for evolveum/midpoint:${MP_VER}-alpine
MP_VER=latest

# Used on first MidPoint init (and as default MIDPOINT_PASSWORD below)
MIDPOINT_ADMIN_INITIAL_PASSWORD=change-me

# MidPoint REST (used by SCIM plugin and application MidPoint lookup)
MIDPOINT_URL=http://midpoint:8080/midpoint/ws/rest
MIDPOINT_USERNAME=administrator
# Defaults to MIDPOINT_ADMIN_INITIAL_PASSWORD when unset
MIDPOINT_PASSWORD=
# Optional Host override if MidPoint rejects the Docker hostname
# MIDPOINT_HOST_HEADER=localhost

# --- SCIM service -----------------------------------------------------------
# Default: public image (docker pull harrykodden/scim)
SCIM_IMAGE=harrykodden/scim:latest
SCIM_LOGLEVEL=INFO
SCIM_API_KEY=secret
SCIM_BASE_PATH=/api/v2

# SCIM: match Invite Group create to existing MidPoint Role by name; Group DELETE no-op
MIDPOINT_LEADING_GROUPS=true

# Invite API + demo-app OIDC live in the profile file selected by ENV_FILE
# (see .env.invite.example / .test.env.example). Do not put INVITE_* / OIDC_* here.

# --- Demo application (non-profile) ----------------------------------------
APP_FLASK_SECRET_KEY=change-me
APP_SESSION_COOKIE_SECURE=true
# Extra OIDC claims JSON/list (optional; profile supplies OIDC_* issuer/client)
# APP_OIDC_CLAIMS=
# Used for SCIM catalog/membership lookup (in-cluster default shown)
APP_SCIM_URL=http://scim:8000/api/v2
# Public URL of the invite_bridge form (MidPoint additionalMenuLink target)
# INVITE_BRIDGE_PUBLIC_URL=https://invite-bridge.example.org/invite
# INVITE_BRIDGE_REGISTER_MENU=true
# INVITE_BRIDGE_UI_USER=administrator
# INVITE_BRIDGE_UI_PASSWORD=
