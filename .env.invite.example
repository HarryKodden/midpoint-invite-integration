# Copy to .env.invite and fill for the "current / shared" Invite profile.
#   cp .env.invite.example .env.invite
#
# Selected with: ENV_FILE=.env.invite

INVITE_API_BASE_URL=https://invite.test.surfconext.nl/api/external/v1
INVITE_API_TOKEN=
INVITE_ORGANIZATION_GUID=
INVITE_APPLICATION_MANAGE_ID=
INVITE_APPLICATION_MANAGE_TYPE=OIDC10_RP
INVITE_APPLICATION_LANDING_PAGE=https://app.example.org/
INVITE_DEFAULT_EXPIRY_DAYS=365
INVITE_INVITATION_EXPIRY_DAYS=14
SYNC_INTERVAL_SECONDS=30
INVITE_BRIDGE_SYNC_MEMBERSHIPS=true
INVITE_CREATE_FAIL_MAX_ATTEMPTS=1
INVITE_CREATE_FAIL_BACKOFF_SECONDS=0
INVITE_BRIDGE_STATE=/data/invite_links.json
# INVITE_BRIDGE_MEMBERSHIPS_STATE=/data/invite_links_memberships.json

OIDC_ISSUER_URL=https://connect.test.surfconext.nl
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://app.example.org/auth/callback
OIDC_SCOPE=openid profile email
USER_LOOKUP_CLAIMS=eduperson_principal_name
