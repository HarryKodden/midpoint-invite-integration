# Copy to .test.env and fill for your private Invite / SURFconext.
#   cp .test.env.example .test.env
#
# Selected with: ENV_FILE=.test.env
# Then recreate: docker compose -f compose.yml -f compose.traefik.yml up -d --force-recreate --no-deps invite_bridge application

INVITE_API_BASE_URL=https://invite.example.org/api/external/v1
INVITE_API_TOKEN=
INVITE_ORGANIZATION_GUID=
INVITE_APPLICATION_MANAGE_ID=
INVITE_APPLICATION_MANAGE_TYPE=OIDC10_RP
INVITE_APPLICATION_LANDING_PAGE=https://app.example.org/
INVITE_DEFAULT_EXPIRY_DAYS=365
INVITE_INVITATION_EXPIRY_DAYS=14
SYNC_INTERVAL_SECONDS=30
INVITE_BRIDGE_SYNC_MEMBERSHIPS=true
INVITE_CREATE_FAIL_MAX_ATTEMPTS=1
INVITE_CREATE_FAIL_BACKOFF_SECONDS=0
INVITE_BRIDGE_STATE=/data/invite_links.test.json
# INVITE_BRIDGE_MEMBERSHIPS_STATE=/data/invite_links.test_memberships.json

OIDC_ISSUER_URL=https://connect.e-tunity.net
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://app.example.org/auth/callback
OIDC_SCOPE=openid profile email
USER_LOOKUP_CLAIMS=eduperson_principal_name
